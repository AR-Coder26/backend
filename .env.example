# ==========================================
# SERVER
# ==========================================
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# ==========================================
# DATABASE
# ==========================================
MONGO_URI=mongodb://<username>:<password>@<cluster-url>/<database-name>?

# ==========================================
# JWT AUTH (Access + Refresh Token Strategy)
# ==========================================
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRY=7d
COOKIE_DOMAIN=localhost

# ==========================================
# JWT AUTH - CUSTOMER (separate secrets from Admin, on purpose -
# a leaked customer token must never be usable against the admin panel)
# ==========================================
CUSTOMER_JWT_ACCESS_SECRET=replace_with_a_long_random_string_customer_access
CUSTOMER_JWT_ACCESS_EXPIRY=15m
CUSTOMER_JWT_REFRESH_SECRET=replace_with_a_different_long_random_string_customer_refresh
CUSTOMER_JWT_REFRESH_EXPIRY=30d

# ==========================================
# CLOUDINARY
# ==========================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==========================================
# EMAIL ALERTS - free new-order notification to the shop owner via Gmail
# (You need a Gmail App Password, not your normal password)
# ==========================================
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
ADMIN_ALERT_EMAIL=owner-email-to-receive-alerts@example.com

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100